# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/procurement?schema=public"

# Azure AD (NextAuth) — from Azure Portal > App registrations > Your app
AZURE_AD_CLIENT_ID="your-azure-ad-client-id"
AZURE_AD_CLIENT_SECRET="your-azure-ad-client-secret"
AZURE_AD_TENANT_ID="your-azure-ad-tenant-id"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Zoho Books (optional — item lookup on New request)
ZOHO_BOOKS_ACCESS_TOKEN=""
ZOHO_BOOKS_ORG_ID=""
# Required for OAuth callback and for automatic token refresh (on 401)
# ZOHO_BOOKS_CLIENT_ID=""
# ZOHO_BOOKS_CLIENT_SECRET=""
# ZOHO_BOOKS_REFRESH_TOKEN=""
# Optional: accounts server for refresh (India use https://accounts.zoho.in)
# ZOHO_BOOKS_ACCOUNTS_SERVER="https://accounts.zoho.com"
# Optional: override Books API base URL if you get "Invalid URL Passed" (e.g. https://www.zoho.in/books/api/v3)
# ZOHO_BOOKS_API_BASE_URL=""
# Optional: Zoho API request timeout in ms (default 20000). If you get 504 Gateway Timeout, raise your reverse proxy timeout for /api/zoho/* (e.g. 90s) or set this higher.
# ZOHO_REQUEST_TIMEOUT_MS="20000"
# Optional: Cache Zoho items list for this many ms (default 600000 = 10 min). Speeds up repeated lookups; set to 0 or leave unset to use default.
# ZOHO_ITEMS_CACHE_TTL_MS="600000"
# Optional: Secret for cron/weekly sync of Zoho Books items into DB. Set and use in scripts/sync-zoho-books.ts or cron: POST /api/zoho/sync with Authorization: Bearer <secret>
# ZOHO_SYNC_CRON_SECRET=""

# Daily sync of the "Production Status" Excel workbook (SharePoint/OneDrive) into the DB via Microsoft Graph.
# Access, either way:
#  (1) Connect the workbook owner's account once: add delegated Files.Read + offline_access to the AZURE_AD_* app, register the
#      redirect URI <NEXTAUTH_URL>/api/production-status/callback, then a Super Admin opens /api/production-status/connect.
#  (2) Or an admin-consented Graph application permission (Files.Read.All, or Sites.Selected for a SharePoint site), using
#      GRAPH_TENANT_ID / GRAPH_CLIENT_ID / GRAPH_CLIENT_SECRET (falling back to the AZURE_AD_* values).
# Cron: POST /api/production-status/sync with Authorization: Bearer <PRODUCTION_STATUS_CRON_SECRET>
# PRODUCTION_STATUS_CRON_SECRET=""
# PRODUCTION_STATUS_FILE_NAME="Production Status.xlsx"
# PRODUCTION_STATUS_DRIVE_USER="owner@yourdomain.com"   # file in this user's OneDrive, or:
# PRODUCTION_STATUS_DRIVE_ID=""                          # SharePoint document library drive id (takes priority)
# PRODUCTION_STATUS_SHEET_NAME=""                        # optional; defaults to the first sheet

# Zoho CRM (optional — autofill Project/Customer, Deal, Charge code on New request)
ZOHO_CRM_ACCESS_TOKEN=""
# ZOHO_CRM_CLIENT_ID=""
# ZOHO_CRM_CLIENT_SECRET=""
# ZOHO_CRM_REFRESH_TOKEN=""

# Email (optional; when set, real emails are sent using configured templates)
# RESEND_API_KEY=""

# Proxy (optional; only if the server is behind a corporate HTTP/HTTPS proxy)
# Set these when running npm install, prisma generate, and when starting the app (e.g. in PM2/systemd).
# HTTP_PROXY="http://proxy.company.com:8080"
# HTTPS_PROXY="http://proxy.company.com:8080"
# NO_PROXY="localhost,127.0.0.1"
# If Prisma engine download fails with 403, also set: PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1
